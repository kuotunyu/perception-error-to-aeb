{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One simulation run's identity, inputs, window, outcome and outputs.",
  "properties": {
    "artifacts": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "cohort_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cohort Manifest Sha256",
      "type": "string"
    },
    "commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Commit",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "finished_at_utc": {
      "title": "Finished At Utc",
      "type": "string"
    },
    "hardware": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Hardware",
      "type": "object"
    },
    "lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Lock Sha256",
      "type": "string"
    },
    "protocol_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protocol Sha256",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "aeb-run/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "started_at_utc": {
      "title": "Started At Utc",
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "aborted"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "commit",
    "config_sha256",
    "protocol_sha256",
    "cohort_manifest_sha256",
    "lock_sha256",
    "hardware",
    "seed",
    "started_at_utc",
    "finished_at_utc",
    "status",
    "artifacts"
  ],
  "title": "RunRecordV1",
  "type": "object"
}
